<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>Jellyfin.Plugin.Ratings</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.Ratings</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <Version>2.0.357.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="10.11.0" />
    <PackageReference Include="Jellyfin.Model" Version="10.11.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration\*.html" />
    <!-- ratings.js and ratings.css are embedded as MINIFIED copies (see the statically-declared
         resources and the Minify* targets below), so exclude the raw sources here to avoid
         duplicate resource names. The i18n\*.js language packs are embedded as-is. -->
    <EmbeddedResource Include="Web\**\*.*" Exclude="Web\ratings.js;Web\ratings.css" />
    <EmbeddedResource Include="Pages\*" />
    <!-- Minified assets, generated before CoreCompile. Literal paths are included as items from
         evaluation time even though the files are produced during the build, so the compiler
         embeds them under the SAME resource names the controller serves. -->
    <EmbeddedResource Include="$(IntermediateOutputPath)ratings.min.js" LogicalName="Jellyfin.Plugin.Ratings.Web.ratings.js" />
    <EmbeddedResource Include="$(IntermediateOutputPath)ratings.min.css" LogicalName="Jellyfin.Plugin.Ratings.Web.ratings.css" />
  </ItemGroup>

  <!-- Pre-compressed (.br/.gz) copies of every served asset.
       These MUST be declared statically here rather than inside the CompressAssets target: items
       added to @(EmbeddedResource) from a target run after the resource pipeline has already been
       prepared, so they are silently ignored. Declaring the literal paths at evaluation time works
       even though the files are produced during the build - the compiler only reads them at
       CoreCompile, which is the same trick the minified assets above rely on.
       Each generated file is named after the resource name it should carry, so LogicalName is
       just %(Filename)%(Extension) (e.g. "…Web.i18n.es.js" + ".br").
       If Node is unavailable the target below creates these as ZERO-BYTE files; the controller
       treats an empty variant as absent and serves the uncompressed asset instead. -->
  <ItemGroup>
    <_LangPackSource Include="Web/i18n/*.js" />

    <EmbeddedResource Include="$(IntermediateOutputPath)compressed\Jellyfin.Plugin.Ratings.Web.ratings.js.br" LogicalName="Jellyfin.Plugin.Ratings.Web.ratings.js.br" />
    <EmbeddedResource Include="$(IntermediateOutputPath)compressed\Jellyfin.Plugin.Ratings.Web.ratings.js.gz" LogicalName="Jellyfin.Plugin.Ratings.Web.ratings.js.gz" />
    <EmbeddedResource Include="$(IntermediateOutputPath)compressed\Jellyfin.Plugin.Ratings.Web.ratings.css.br" LogicalName="Jellyfin.Plugin.Ratings.Web.ratings.css.br" />
    <EmbeddedResource Include="$(IntermediateOutputPath)compressed\Jellyfin.Plugin.Ratings.Web.ratings.css.gz" LogicalName="Jellyfin.Plugin.Ratings.Web.ratings.css.gz" />

    <EmbeddedResource Include="@(_LangPackSource->'$(IntermediateOutputPath)compressed\Jellyfin.Plugin.Ratings.Web.i18n.%(Filename)%(Extension).br')">
      <LogicalName>%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="@(_LangPackSource->'$(IntermediateOutputPath)compressed\Jellyfin.Plugin.Ratings.Web.i18n.%(Filename)%(Extension).gz')">
      <LogicalName>%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Set this on release builds (dotnet build -c Release -p:RequireMinification=true) to turn a
       missing esbuild into a hard error. Without it a machine with no Node silently ships the
       unminified sources - which is exactly what happened before: the fallback Copy below is
       quiet enough that a ~60% bundle regression can go out behind a single warning. -->
  <PropertyGroup>
    <RequireMinification Condition="'$(RequireMinification)' == ''">false</RequireMinification>
  </PropertyGroup>

  <!-- Build-time minification of the injected web bundle.
       The source Web/ratings.js stays readable/editable; the build embeds a minified copy.
       esbuild only compacts whitespace and LOCAL variable names - it never renames object or
       API property names - so runtime behavior is preserved. -->
  <Target Name="MinifyRatingsJs" BeforeTargets="CoreCompile" Inputs="Web/ratings.js" Outputs="$(IntermediateOutputPath)ratings.min.js">
    <Exec Command="npx --yes esbuild@0.28.0 &quot;Web/ratings.js&quot; --minify --charset=utf8 --legal-comments=none --log-level=error --outfile=&quot;$(IntermediateOutputPath)ratings.min.js&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ContinueOnError="true" />
    <Error Condition="'$(RequireMinification)' == 'true' And !Exists('$(IntermediateOutputPath)ratings.min.js')"
           Text="esbuild is unavailable, so ratings.js would ship UNMINIFIED. Install Node.js, or build without -p:RequireMinification=true for a local/dev build." />
    <Warning Condition="!Exists('$(IntermediateOutputPath)ratings.min.js')" Text="esbuild minify unavailable - embedding unminified ratings.js" />
    <Copy Condition="!Exists('$(IntermediateOutputPath)ratings.min.js')" SourceFiles="Web/ratings.js" DestinationFiles="$(IntermediateOutputPath)ratings.min.js" />
  </Target>

  <!-- Same treatment for the stylesheet. This is the change that actually pays: as a template
       literal inside ratings.js the CSS was copied byte-for-byte by esbuild (template contents are
       string data, not code), so ~374 KB of indented CSS shipped completely unminified. -->
  <Target Name="MinifyRatingsCss" BeforeTargets="CoreCompile" Inputs="Web/ratings.css" Outputs="$(IntermediateOutputPath)ratings.min.css">
    <Exec Command="npx --yes esbuild@0.28.0 &quot;Web/ratings.css&quot; --minify --charset=utf8 --legal-comments=none --log-level=error --outfile=&quot;$(IntermediateOutputPath)ratings.min.css&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ContinueOnError="true" />
    <Error Condition="'$(RequireMinification)' == 'true' And !Exists('$(IntermediateOutputPath)ratings.min.css')"
           Text="esbuild is unavailable, so ratings.css would ship UNMINIFIED. Install Node.js, or build without -p:RequireMinification=true for a local/dev build." />
    <Warning Condition="!Exists('$(IntermediateOutputPath)ratings.min.css')" Text="esbuild minify unavailable - embedding unminified ratings.css" />
    <Copy Condition="!Exists('$(IntermediateOutputPath)ratings.min.css')" SourceFiles="Web/ratings.css" DestinationFiles="$(IntermediateOutputPath)ratings.min.css" />
  </Target>

  <!-- Brotli + gzip copies of every served asset, so the plugin can set its own Content-Encoding.
       This matters because Jellyfin registers response compression with EnableForHttps left at its
       default of false, so direct-HTTPS clients otherwise get no compression at all - and a plugin
       cannot change that setting. Runs after minification and before compile. -->
  <Target Name="CompressAssets"
          BeforeTargets="CoreCompile"
          DependsOnTargets="MinifyRatingsJs;MinifyRatingsCss">
    <ItemGroup>
      <_AssetToCompress Include="Jellyfin.Plugin.Ratings.Web.ratings.js=$(IntermediateOutputPath)ratings.min.js" />
      <_AssetToCompress Include="Jellyfin.Plugin.Ratings.Web.ratings.css=$(IntermediateOutputPath)ratings.min.css" />
      <_LangPack Include="Web/i18n/*.js" />
      <_AssetToCompress Include="@(_LangPack->'Jellyfin.Plugin.Ratings.Web.i18n.%(Filename)%(Extension)=%(FullPath)')" />
    </ItemGroup>

    <Exec Command="node &quot;tools/compress-assets.js&quot; &quot;$(IntermediateOutputPath)compressed&quot; @(_AssetToCompress->'&quot;%(Identity)&quot;', ' ')"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ContinueOnError="true" />

    <Error Condition="'$(RequireMinification)' == 'true' And !Exists('$(IntermediateOutputPath)compressed\Jellyfin.Plugin.Ratings.Web.ratings.js.br')"
           Text="Asset pre-compression did not run (Node unavailable?), so assets would ship uncompressed to direct-HTTPS clients." />
    <Warning Condition="!Exists('$(IntermediateOutputPath)compressed\Jellyfin.Plugin.Ratings.Web.ratings.js.br')"
             Text="Node unavailable - shipping without pre-compressed assets (the controller will serve them uncompressed)." />

    <!-- The EmbeddedResource items are declared statically, so every one of these paths must
         exist by CoreCompile or csc fails outright. When compression did not run we create them
         empty; the controller treats a zero-length variant as absent and serves identity. -->
    <ItemGroup>
      <_ExpectedCompressed Include="$(IntermediateOutputPath)compressed\Jellyfin.Plugin.Ratings.Web.ratings.js.br;$(IntermediateOutputPath)compressed\Jellyfin.Plugin.Ratings.Web.ratings.js.gz;$(IntermediateOutputPath)compressed\Jellyfin.Plugin.Ratings.Web.ratings.css.br;$(IntermediateOutputPath)compressed\Jellyfin.Plugin.Ratings.Web.ratings.css.gz" />
      <_ExpectedCompressed Include="@(_LangPackSource->'$(IntermediateOutputPath)compressed\Jellyfin.Plugin.Ratings.Web.i18n.%(Filename)%(Extension).br')" />
      <_ExpectedCompressed Include="@(_LangPackSource->'$(IntermediateOutputPath)compressed\Jellyfin.Plugin.Ratings.Web.i18n.%(Filename)%(Extension).gz')" />
    </ItemGroup>

    <!-- MakeDir first: without Node the script never ran, so the output directory does not exist
         and Touch cannot create files inside it. -->
    <MakeDir Directories="$(IntermediateOutputPath)compressed" />
    <Touch Files="@(_ExpectedCompressed)" AlwaysCreate="true" Condition="!Exists('%(Identity)')" />
  </Target>

</Project>
